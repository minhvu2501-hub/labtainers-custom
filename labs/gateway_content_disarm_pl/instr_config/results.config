gateway_started = gateway_proxy:.bash_history : STRING_COUNT : audio_gateway.py
download_attempt = user_pc:.bash_history : STRING_COUNT : 10.0.0.1:8000
report_exists = gateway_proxy:scan_report.txt : CONTAINS : Status
clean_detected = gateway_proxy:scan_report.txt : STRING_COUNT : CLEAN
warning_detected = gateway_proxy:scan_report.txt : STRING_COUNT : THREAT
